[Unit]
Description=cefbrowser
Requires=network-online.target
After=network-online.target
StartLimitIntervalSec=3
StartLimitBurst=10

[Service]
WorkingDirectory=/storage/browser
ExecStartPre=/bin/sh -c 'test -f /storage/browser/addon.cefruntime/@CEF_VERSION@/lib/libcef.so || { echo "cefruntime @CEF_VERSION@ is missing, install it with install.sh -R"; exit 1; }'
ExecStart=/storage/browser/addon.cefbrowser/bin/cefbrowser --zoom=1920 --config /storage/.config/vdropt/sockets.ini --ozone-platform=headless --resources-dir-path=/storage/browser/addon.cefruntime/@CEF_VERSION@/lib --locales-dir-path=/storage/browser/addon.cefruntime/@CEF_VERSION@/lib/locales --log-file=/storage/.cache/cefbrowser/cefbrowser.log --cachePath=/storage/.cache/cefbrowser --profilePath=/storage/.cache/cefbrowser --staticPath=/storage/browser/addon.cefbrowser/data
Restart=always
RestartSec=3
Environment=LD_LIBRARY_PATH="/storage/browser/addon.cefruntime/@CEF_VERSION@/lib/private/:/storage/browser/addon.cefruntime/@CEF_VERSION@/lib/"
Environment=BROWSER_DB_PATH="/storage/browser/database"
Environment=FONTCONFIG_FILE="/storage/browser/addon.cefbrowser/etc/fonts.conf"
StartLimitInterval=0
TimeoutStartSec=30
TimeoutStopSec=30
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target