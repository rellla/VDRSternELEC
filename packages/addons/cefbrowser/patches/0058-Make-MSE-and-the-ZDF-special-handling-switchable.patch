 static-content/js/initlast.js      |  5 +++--
 static-content/js/videoobserver.js |  9 +++++++--
 tools.cpp                          |  2 ++
 tools.h                            |  9 +++++++++
 xhrinterception.cpp                |  6 ++++--
 8 files changed, 43 insertions(+), 8 deletions(-)

diff --git a/browserclient.cpp b/browserclient.cpp
