From ce547bfd7ab7308f1b3e37f5d97fb2fadc065885 Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Thu, 29 Oct 2026 16:54:51 +0100
Subject: [PATCH 10/59] Remove only registered stream event listeners

splice(-1, 1) removed the last listener if the given one was not
registered.

Co-Authored-By: Claude Opus 5.5
---
 static-content/js/videoobserver.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/static-content/js/videoobserver.js b/static-content/js/videoobserver.js
index b0fbcb0..98a39d9 100644
--- a/static-content/js/videoobserver.js
+++ b/static-content/js/videoobserver.js
@@ -154,7 +154,9 @@ function addNodeFunctions(node) {
             return e.listener === listener && e.eventName === eventName && e.url === url;
         });
 
-        window.HBBTV_POLYFILL_NS.streamEventListeners.splice(idx, 1);
+        if (idx >= 0) {
+            window.HBBTV_POLYFILL_NS.streamEventListeners.splice(idx, 1);
+        }
     };
 }
 
