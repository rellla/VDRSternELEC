From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Sun, 1 Nov 2026 09:00:10 +0100
Subject: [PATCH 49/59] Set resolution and frame rate at runtime

Implement SetRenderParameters: VDR can change the size of the page
(1280, 1920, 2560 or 3840 pixels wide) and the frame rate of the
offscreen rendering without restarting the browser.

Co-Authored-By: Claude Opus 5.5
---
 browserclient.h   |  1 +
 browserserver.cpp | 40 ++++++++++++++++++++++++++++++++++++++--
 main.cpp          |  7 +------
 tools.cpp         | 20 ++++++++++++++++++++
 tools.h           |  6 ++++++
 5 files changed, 66 insertions(+), 8 deletions(-)

diff --git a/browserclient.h b/browserclient.h
index ccc0c51..9a08d21 100644
--- a/browserclient.h
+++ b/browserclient.h
@@ -61,6 +61,7 @@ public:
 
     // RenderHandler
     void setRenderSize(int width, int height);
+    int getRenderWidth() const { return renderWidth; }
 
     void GetViewRect(CefRefPtr<CefBrowser> browser, CefRect &rect) override;
 
diff --git a/browserserver.cpp b/browserserver.cpp
index a6d2573..9de87be 100644
--- a/browserserver.cpp
+++ b/browserserver.cpp
@@ -348,8 +348,44 @@ bool BrowserServer::StreamEvent(const StreamEventType &input) {
 }
 
 bool BrowserServer::SetRenderParameters(const RenderParametersType &input) {
-    // not supported yet
-    return false;
+    GET_BROWSER(browser, false)
+
+    int height = 0;
+    double zoomLevel = 1.0;
+    bool newSize = input.width > 0 && zoomForWidth(input.width, height, zoomLevel);
+
+    if (input.width > 0 && !newSize) {
+        ERROR("SetRenderParameters: unsupported width {}", input.width);
+    }
+
+    int width = input.width;
+    int frameRate = input.frameRate;
+    std::string staticPath = bParameterServer.static_path;
+
+    runOnUiThread([browser, newSize, width, height, zoomLevel, frameRate, staticPath]() {
+        if (frameRate > 0 && frameRate != browser->GetHost()->GetWindowlessFrameRate()) {
+            INFO("Set frame rate to {}", frameRate);
+            browser->GetHost()->SetWindowlessFrameRate(frameRate);
+        }
+
+        if (newSize) {
+            CefRefPtr<CefClient> client = browser->GetHost()->GetClient();
+            auto c = dynamic_cast<BrowserClient *>(client.get());
+            if (c == nullptr || c->getRenderWidth() == width) {
+                return;
+            }
+
+            INFO("Set render size to {}x{}", width, height);
+            writeZoomScript(staticPath, width, height, zoomLevel);
+            c->setRenderSize(width, height);
+            browser->GetHost()->WasResized();
+
+            // the zoom of the page is set when it is loaded
+            browser->Reload();
+        }
+    });
+
+    return true;
 }
 
 CefBrowserIf *BrowserCloneFactory::getHandler(const TConnectionInfo &connInfo) {
diff --git a/main.cpp b/main.cpp
index 975fc36..7cc1330 100644
--- a/main.cpp
+++ b/main.cpp
@@ -471,12 +471,7 @@ int main(int argc, char *argv[]) {
     sigaction(SIGQUIT, &sigIntHandler, nullptr);
 
     // write zoom level script
-    std::ofstream _zoom_level;
-    _zoom_level.open (staticPath + "/js/_zoom_level.js", std::ios_base::trunc);
-    _zoom_level << "document.body.style[\"zoom\"] = " << zoom_level << ";\n" << std::endl;
-    _zoom_level << "document.body.style[\"width\"] = \"" << zoom_width << "px\";\n" << std::endl;
-    _zoom_level << "document.body.style[\"height\"] = \"" << zoom_height << "px\";\n" << std::endl;
-    _zoom_level.close();
+    writeZoomScript(staticPath, zoom_width, zoom_height, zoom_level);
 
     // Run the CEF message loop. This will block until CefQuitMessageLoop() is called.
     CefRunMessageLoop();
diff --git a/tools.cpp b/tools.cpp
index f745131..6875f63 100644
--- a/tools.cpp
+++ b/tools.cpp
@@ -1,3 +1,4 @@
+#include <fstream>
 #include "tools.h"
 
 bool endsWith(const std::string& str, const std::string& suffix) {
@@ -22,3 +23,22 @@ std::string readFile(const char *filename)
     }
     return "";
 }
+
+bool zoomForWidth(int width, int &height, double &zoomLevel) {
+    switch (width) {
+        case 1280: height = 720;  zoomLevel = 1.0; return true;
+        case 1920: height = 1080; zoomLevel = 1.5; return true;
+        case 2560: height = 1440; zoomLevel = 2.0; return true;
+        case 3840: height = 2160; zoomLevel = 3.0; return true;
+        default:   return false;
+    }
+}
+
+void writeZoomScript(const std::string& staticPath, int width, int height, double zoomLevel) {
+    std::ofstream zoom;
+    zoom.open(staticPath + "/js/_zoom_level.js", std::ios_base::trunc);
+    zoom << "document.body.style[\"zoom\"] = " << zoomLevel << ";\n" << std::endl;
+    zoom << "document.body.style[\"width\"] = \"" << width << "px\";\n" << std::endl;
+    zoom << "document.body.style[\"height\"] = \"" << height << "px\";\n" << std::endl;
+    zoom.close();
+}
diff --git a/tools.h b/tools.h
index 8d05bb3..5b57681 100644
--- a/tools.h
+++ b/tools.h
@@ -35,5 +35,11 @@ typedef struct BrowserParameter {
 } BrowserParameter;
 
 bool endsWith(const std::string& str, const std::string& suffix);
+
+// height and zoom level for a page width (1280, 1920, 2560, 3840). Returns false for other widths.
+bool zoomForWidth(int width, int &height, double &zoomLevel);
+
+// writes the script which sets the zoom of every page
+void writeZoomScript(const std::string& staticPath, int width, int height, double zoomLevel);
 bool startsWith(const std::string& str, const std::string& prefix);
 std::string readFile(const char *filename);
