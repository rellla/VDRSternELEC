From 4e5e8225ba9d73e5688f0959ae3c0e1e7d68c1aa Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Thu, 29 Oct 2026 16:55:56 +0100
Subject: [PATCH 15/59] Check all added video objects

Only the first added node of a mutation summary was checked.

Co-Authored-By: Claude Opus 5.5
---
 static-content/js/videoobserver.js | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/static-content/js/videoobserver.js b/static-content/js/videoobserver.js
index 98a39d9..d990127 100644
--- a/static-content/js/videoobserver.js
+++ b/static-content/js/videoobserver.js
@@ -664,8 +664,8 @@ function checkAddedObjectNode(summaries) {
         return;
     }
 
-    let node = summaries.added[0];
-    checkSingleObjectNode(node);
+    // several objects may be added at once
+    summaries.added.forEach((node) => checkSingleObjectNode(node));
 }
 
 function checkSingleObjectNode(node) {
-- 
