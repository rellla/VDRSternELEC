From 87ea9eeff614c31b8af040887f1bde38fad9bf40 Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Fri, 30 Oct 2026 12:43:24 +0100
Subject: [PATCH 32/59] Enable remote debugging only on request

The DevTools port 9222 was always open. Add --remotedebug <port> and
keep it disabled by default.

Co-Authored-By: Claude Opus 5.5
---
 README.md                        |  2 ++
 main.cpp                         | 11 +++++++++--
 start-scripte/start-local-dev.sh |  2 +-
 3 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/README.md b/README.md
index bff1994..07e9f6a 100644
--- a/README.md
+++ b/README.md
@@ -67,6 +67,8 @@ It's up to you to decide what you want to use and test ;)
          this directory. E.g. css, html, javascript and so on.
 -b / --bindall The browser uses every network interface. Could lead to 
          interesting effects if Docker/Incus/LXD is also installed.                  
+-r / --remotedebug <port> Enables the Chromium DevTools on the given
+         port (e.g. 9222). Disabled by default.
 ```
 
 ### Logging
diff --git a/main.cpp b/main.cpp
index 48b53fe..3a94d97 100644
--- a/main.cpp
+++ b/main.cpp
@@ -44,6 +44,7 @@ double zoom_level;
 bool use_dirty_recs;
 
 bool bindAll;
+int remoteDebuggingPort = 0;
 
 CefRefPtr<BrowserApp> app;
 
@@ -106,6 +107,7 @@ void parseCommandLine(int argc, char *argv[]) {
             { "bindall",     optional_argument, nullptr, 'b' },
             { "uagent",      optional_argument, nullptr, 'u' },
             { "browserdb",   optional_argument, nullptr, 'd' },
+            { "remotedebug", required_argument, nullptr, 'r' },
             { nullptr }
     };
 
@@ -122,7 +124,7 @@ void parseCommandLine(int argc, char *argv[]) {
     staticPath = getexepath();
     staticPath = staticPath.substr(0, staticPath.find_last_of('/'));
 
-    while ((c = getopt_long(argc, argv, "qc:l:z:fp:s:bu:d:a:", long_options, &option_index)) != -1)
+    while ((c = getopt_long(argc, argv, "qc:l:z:fp:s:bu:d:a:r:", long_options, &option_index)) != -1)
     {
         switch (c)
         {
@@ -198,6 +200,10 @@ void parseCommandLine(int argc, char *argv[]) {
                 cachePath = optarg;
                 break;
 
+            case 'r':
+                remoteDebuggingPort = atoi(optarg);
+                break;
+
             default:
                 // return;
                 break;
@@ -337,7 +343,8 @@ int main(int argc, char *argv[]) {
     CefSettings settings;
     settings.windowless_rendering_enabled = true;
     settings.no_sandbox = true;
-    settings.remote_debugging_port = 9222;
+    // remote debugging (DevTools) only on request, it costs memory and opens a port
+    settings.remote_debugging_port = remoteDebuggingPort;
 
     // CefString(&settings.user_agent).FromASCII("HbbTV/1.4.1 (+DL+PVR+DRM;Samsung;SmartTV2015;T-HKM6DEUC-1490.3;;) OsrTvViewer;Chrome");
     // CefString(&settings.user_agent).FromASCII("HbbTV/1.2.1 (+DL+PVR+DRM;Samsung;SmartTV2015;T-HKM6DEUC-1490.3;;) OsrTvViewer;Chrome");
diff --git a/start-scripte/start-local-dev.sh b/start-scripte/start-local-dev.sh
index 1adb695..c679011 100644
--- a/start-scripte/start-local-dev.sh
+++ b/start-scripte/start-local-dev.sh
@@ -1,3 +1,3 @@
 #!/bin/bash
 
- ./cefbrowser -l 3  --config=sockets.ini --remote-allow-origins=http://localhost:9222 | tee browser.log
+ ./cefbrowser -l 3  --config=sockets.ini --remotedebug=9222 --remote-allow-origins=http://localhost:9222 | tee browser.log
-- 
2.43.0

