From 699c26401c2869b92a6048ecc854ca4f661ae854 Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Thu, 29 Oct 2026 16:55:21 +0100
Subject: [PATCH 13/59] Support range requests for the transparent video

The response always started at byte 0, but claimed to be the
requested range. Seeking in the transparent video delivered wrong
data, the media player reported an error and the video was stopped.

Co-Authored-By: Claude Opus 5.5
---
 moviestream.cpp | 46 ++++++++++++++++++++++++++++++++++++++--------
 moviestream.h   |  3 +++
 2 files changed, 41 insertions(+), 8 deletions(-)

diff --git a/moviestream.cpp b/moviestream.cpp
index 8500641..dba227a 100644
--- a/moviestream.cpp
+++ b/moviestream.cpp
@@ -11,7 +11,7 @@ CefResourceRequestHandler::ReturnValue MovieStream::OnBeforeResourceLoad(CefRefP
     return RV_CONTINUE;
 }
 
-MovieStream::MovieStream(TranscoderClient *client) : offset(0), download_total(0), transcoderClient(client) {
+MovieStream::MovieStream(TranscoderClient *client) : offset(0), range_start(0), range_end(0), is_range_request(false), download_total(0), transcoderClient(client) {
 }
 
 bool MovieStream::Open(CefRefPtr<CefRequest> request, bool& handle_request, CefRefPtr<CefCallback> callback) {
@@ -33,6 +33,27 @@ bool MovieStream::Open(CefRefPtr<CefRequest> request, bool& handle_request, CefR
     }
     download_total = download_data.length();
 
+    // The media player seeks with range requests ("bytes=start-[end]").
+    // Answering always from byte 0 corrupts the data after a seek.
+    is_range_request = false;
+    range_start = 0;
+    range_end = download_total > 0 ? download_total - 1 : 0;
+
+    std::string range = request->GetHeaderByName("Range").ToString();
+    unsigned long long start = 0, end = 0;
+    if (download_total > 0 && range.rfind("bytes=", 0) == 0) {
+        int n = sscanf(range.c_str() + 6, "%llu-%llu", &start, &end);
+        if (n >= 1 && start < download_total) {
+            is_range_request = true;
+            range_start = start;
+            if (n == 2 && end >= start && end < download_total) {
+                range_end = end;
+            }
+        }
+    }
+
+    offset = range_start;
+
     // handled immediately, the callback must not be used in this case
     handle_request = true;
     return true;
@@ -41,9 +62,9 @@ bool MovieStream::Open(CefRefPtr<CefRequest> request, bool& handle_request, CefR
 bool MovieStream::Read(void* data_out, int bytes_to_read, int& bytes_read, CefRefPtr<CefResourceReadCallback> callback) {
     // TRACE("MovieStream::Read: {}, Size {}, Offset {}", bytes_to_read, download_data.length(), offset);
 
-    size_t size = download_data.length();
+    size_t size = download_total > 0 ? range_end + 1 : 0;
     if (offset < size) {
-        int transfer_size = std::min(bytes_to_read, static_cast<int>(size - offset));
+        int transfer_size = static_cast<int>(std::min(static_cast<size_t>(bytes_to_read), size - offset));
         memcpy(data_out, download_data.c_str() + offset, transfer_size);
         offset += transfer_size;
 
@@ -66,18 +87,27 @@ void MovieStream::GetResponseHeaders(CefRefPtr<CefResponse> response, int64_t &r
         return;
     }
 
-    response->SetStatus(206);
-    response->SetStatusText("Partial Content");
+    size_t length = range_end - range_start + 1;
+
+    if (is_range_request) {
+        response->SetStatus(206);
+        response->SetStatusText("Partial Content");
+        responseHeader.insert(std::make_pair("Content-Range", "bytes " + std::to_string(range_start) + "-" + std::to_string(range_end) + "/" + std::to_string(download_total)));
+    } else {
+        response->SetStatus(200);
+        response->SetStatusText("OK");
+    }
+
     response->SetMimeType("video/webm");
 
     responseHeader.insert(std::make_pair("Content-Type", "video/webm"));
-    responseHeader.insert(std::make_pair("Content-Range", "bytes 0-" + std::to_string(download_total-1) + "/" + std::to_string(download_total)));
-    responseHeader.insert(std::make_pair("Content-Length", std::to_string(download_total)));
+    responseHeader.insert(std::make_pair("Accept-Ranges", "bytes"));
+    responseHeader.insert(std::make_pair("Content-Length", std::to_string(length)));
     responseHeader.insert(std::make_pair("Vary", "Origin, Access-Control-Request-Headers"));
 
     response->SetHeaderMap(responseHeader);
 
-    response_length = download_total;
+    response_length = static_cast<int64_t>(length);
 }
 
 void MovieStream::Cancel() {
diff --git a/moviestream.h b/moviestream.h
index c29cd92..5d8bd12 100644
--- a/moviestream.h
+++ b/moviestream.h
@@ -35,6 +35,9 @@ public:
 
 private:
     size_t offset;
+    size_t range_start;
+    size_t range_end;      // inclusive
+    bool is_range_request;
     size_t download_total;
     std::string download_data;
     TranscoderClient *transcoderClient;
-- 
