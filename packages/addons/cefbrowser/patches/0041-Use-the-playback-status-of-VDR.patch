+        } else if (state === VDR_STATE_PLAYING && node.playState === PLAY_STATES.buffering) {
+            node.playState = PLAY_STATES.playing;
+            notifyPlayState();
+        }
+    }
+
+    window._vdrActiveMedia = onVdrStatus;
+
