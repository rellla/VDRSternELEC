From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Tue, 13 Oct 2026 22:29:39 +0200
Subject: [PATCH] fix compiler warnings

---
 displaychannel.c | 2 +-
 displaymenu.c    | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/displaychannel.c b/displaychannel.c
index 88f8f8a..33df52e 100644
--- a/displaychannel.c
+++ b/displaychannel.c
@@ -980,7 +980,7 @@ void cDrawChannelDescription::Draw(void)
   int drawportheight = l0 * smlLineHeight;
   int y1 = aI.y1 - viewportheight - rand;              // text bottom
 
-  if (TextPixmap = osd->CreatePixmap(3, cRect(x0, y1, pixmapwidth, viewportheight), cRect(0, 0, pixmapwidth, drawportheight))) {
+  if ((TextPixmap = osd->CreatePixmap(3, cRect(x0, y1, pixmapwidth, viewportheight), cRect(0, 0, pixmapwidth, drawportheight)))) {
      TextPixmap->Fill(aI.textColorBg);
      int y = 0;
      for (int i = 0; i < l0; i++) {
diff --git a/displaymenu.c b/displaymenu.c
index 47428f0..60185bd 100644
--- a/displaymenu.c
+++ b/displaymenu.c
@@ -408,7 +408,7 @@ void cLCARSNGDisplayMenu::DrawMainFrameUpper(tColor Color, tColor ColorBg)
   // Top left rectangles:
   DrawRectangleOutline(osd, nullptr, xa00, yt00, xa02 - 1, yt02 - 1, Color, ColorBg, 15);
   DrawRectangleOutline(osd, nullptr, xa00, yt04, xa02 - 1, yt06 - 1, Color, ColorBg, 15);
-  if ((zoom < 1) || (zoom == 1) && (!(viewmode == esplitscreen)))
+  if ((zoom < 1) || ((zoom == 1) && (!(viewmode == esplitscreen))))
      DrawRectangleOutline(osd, nullptr, xa00, yt07, xa02 - 1, yt08 - 1, Color, ColorBg, 15);
   if ((zoom < 1) && (!(viewmode == esplitscreen || (!((viewmode == escaledvideo)) && (MenuCategory() == mcMain)))))
      if (!(viewmode == escaledvideosmall))
@@ -2074,7 +2074,7 @@ void cDrawDescription::DrawBracket(void)
   int x1 = aI->x1;
   int y0 = aI->y0;
   int y1 = aI->y1;
-  if (BackgroundPixmap = aI->osd->CreatePixmap(-1, cRect(x0, y0, x1 - x0, y1 - y0))) {
+  if ((BackgroundPixmap = aI->osd->CreatePixmap(-1, cRect(x0, y0, x1 - x0, y1 - y0)))) {
      BackgroundPixmap->SetAlpha(0);
      BackgroundPixmap->Fill(((aI->viewmode == escaledvideo) || (aI->viewmode == escaledvideosmall)) ? Theme.Color(clrBackground) : aI->textColorBg);
      }
