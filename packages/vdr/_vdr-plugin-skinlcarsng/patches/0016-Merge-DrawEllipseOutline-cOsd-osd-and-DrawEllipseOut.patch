+                  Pixmap->DrawEllipse(cRect(x1 + margin, y1 + margin, w - 2 * margin, h - margin), Color2, 6);
+               else
+                  Osd->DrawEllipse(x1 + margin, y1 + margin, x2 - margin, y2, Color2, 6);
+               break;
+      case  7: if (Pixmap) // left
+                  Pixmap->DrawEllipse(cRect(x1 + margin, y1 + margin, w - margin, h - 2 * margin), Color2, 7);
+               else
+                  Osd->DrawEllipse(x1 + margin, y1 + margin, x2, y2 - margin, Color2, 7);
+               break;
+      case  8: if (Pixmap) // bottom
+                  Pixmap->DrawEllipse(cRect(x1 + margin, y1, w - 2 * margin, h - margin), Color2, 8);
+               else
+                  Osd->DrawEllipse(x1 + margin, y1, x2 - margin, y2 - margin, Color2, 8);
+               break;
+      case -1: if (Pixmap) // top right invers
+                  Pixmap->DrawEllipse(cRect(x1, y1 - margin, w + margin, h + margin), Color2, -1);
+               else
+                  Osd->DrawEllipse(x1, y1 - margin, x2 + margin, y2, Color2, -1);
+               break;
+      case -2: if (Pixmap) // top left invers
+                  Pixmap->DrawEllipse(cRect(x1 - margin, y1 - margin, w + margin, h + margin), Color2, -2);
+               else
+                  Osd->DrawEllipse(x1 - margin, y1 - margin, x2, y2, Color2, -2);
+               break;
+      case -3: if (Pixmap) // bottom left invers
+                  Pixmap->DrawEllipse(cRect(x1 - margin, y1, w + margin, h + margin), Color2, -3);
+               else
+                  Osd->DrawEllipse(x1 - margin, y1, x2, y2 + margin, Color2, -3);
+               break;
+      case -4: if (Pixmap) // bottom right invers
+                  Pixmap->DrawEllipse(cRect(x1, y1, w + margin, h + margin), Color2, -4);
+               else
+                  Osd->DrawEllipse(x1, y1, x2 + margin, y2 + margin, Color2, -4);
+               break;
+      default: ;
+      }
 }
 
