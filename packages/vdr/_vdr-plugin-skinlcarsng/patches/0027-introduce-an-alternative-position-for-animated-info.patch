From 0f1bffa2544a070b6f111e576230cf3836b27f23 Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Tue, 13 Oct 2026 21:42:00 +0200
Subject: [PATCH] introduce an alternative position for animated info

---
 config.c      |  4 +++-
 config.h      |  1 +
 displaymenu.c | 17 +++++++++++++----
 setup.c       |  2 ++
 4 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/config.c b/config.c
index ea0ad4b..45603c6 100644
--- a/config.c
+++ b/config.c
@@ -7,8 +7,8 @@ cLCARSNGConfig::cLCARSNGConfig(void)
 {
   Margin = 2;
   displayError0 = 0;
-  displInfoMenuEPG = 0;
   displayScraperInfo = 0;
+  displInfoMenuEPG = 0;
   displInfoMenuTimer = 0;
   displInfoMenuRec = 0;
   displInfoChannel = 0;
@@ -18,6 +18,7 @@ cLCARSNGConfig::cLCARSNGConfig(void)
   fadeinTime = 300;
   scrollPixel = 2;
   framesPerSecond = 25;
+  displInfoAlt = 0;
   volumeBarStyle = 0;
   swapTimers = 0;
   displReplayErrors = 0;
@@ -83,6 +84,7 @@ bool cLCARSNGConfig::SetupParse(const char *Name, const char *Value)
   else if (!strcasecmp(Name, "FadeInTime"))         fadeinTime         = atoi(Value);
   else if (!strcasecmp(Name, "ScrollPixel"))        scrollPixel        = atoi(Value);
   else if (!strcasecmp(Name, "FramesPerSecond"))    framesPerSecond    = atoi(Value);
+  else if (!strcasecmp(Name, "DisplInfoAlt"))       displInfoAlt       = atoi(Value);
   else if (!strcasecmp(Name, "VolumeBarStyle"))     volumeBarStyle     = atoi(Value);
   else if (!strcasecmp(Name, "SwapTimers"))         swapTimers         = atoi(Value);
   else if (!strcasecmp(Name, "DisplayErrInRepl"))   displReplayErrors  = atoi(Value);
diff --git a/config.h b/config.h
index 1595310..9978746 100644
--- a/config.h
+++ b/config.h
@@ -24,6 +24,7 @@ public:
   int fadeinTime;
   int scrollPixel;
   int framesPerSecond;
+  int displInfoAlt;
   int volumeBarStyle;
   int swapTimers;
   int displReplayErrors;
diff --git a/displaymenu.c b/displaymenu.c
index b5c5f71..ace491d 100644
--- a/displaymenu.c
+++ b/displaymenu.c
@@ -395,10 +395,19 @@ void cLCARSNGDisplayMenu::SetMenuCategory(eMenuCategory MenuCategory)
         }
      }
 
-  animatedInfo.x0 = xs00;
-  animatedInfo.x1 = xs11;
-  animatedInfo.y0 = yi00;
-  animatedInfo.y1 = yi00 + (int)((yi01 - yi00) / lineHeight) * lineHeight;
+  if (Config.displInfoAlt) {
+     animatedInfo.x0 = xd00;
+     animatedInfo.x1 = xs11;
+     animatedInfo.y0 = yt00;
+     animatedInfo.y1 = yc05;
+     }
+  else {
+     animatedInfo.x0 = xs00;
+     animatedInfo.x1 = xs11;
+     animatedInfo.y0 = yi00;
+     animatedInfo.y1 = yi00 + (int)((yi01 - yi00) / lineHeight) * lineHeight;
+     }
+
   animatedInfo.viewmode = viewmode;
   animatedInfo.Init = true;
   actualpath = NULL;
diff --git a/setup.c b/setup.c
index 7334bf6..3771810 100644
--- a/setup.c
+++ b/setup.c
@@ -89,6 +89,7 @@ void cLCARSNGSetup::Set(void) {
      Add(new cMenuEditIntItem(cString::sprintf("%s%s", *spacer, tr("Waiting period Scroll (ms)")),                  &tmpConfig.waitTimeScroll, 0, 5000, trVDR("off")));
      Add(new cMenuEditIntItem(cString::sprintf("%s%s", *spacer, tr("ScrollPixel")),                                 &tmpConfig.scrollPixel, 1, 10));
      Add(new cMenuEditIntItem(cString::sprintf("%s%s", *spacer, tr("Refreshrate (Frames/s)")),                      &tmpConfig.framesPerSecond, 10, 60));
+     Add(new cMenuEditBoolItem(tr("Use alternate position"),                                                        &tmpConfig.displInfoAlt));
      Add(new cOsdItem("",                                                                                           osUnknown, false));
      }
 
@@ -174,6 +175,7 @@ void cLCARSNGSetup::Store(void) {
   SetupStore("FadeInTime",         Config.fadeinTime);
   SetupStore("ScrollPixel",        Config.scrollPixel);
   SetupStore("FramesPerSecond",    Config.framesPerSecond);
+  SetupStore("DisplInfoAlt",       Config.displInfoAlt);
   SetupStore("VolumeBarStyle",     Config.volumeBarStyle);
   SetupStore("SwapTimers",         Config.swapTimers);
   SetupStore("DisplayErrInRepl",   Config.displReplayErrors);
-- 
2.47.3

