From 1f3fbd22bb9ccd32f56d5579ee807df89134b72c Mon Sep 17 00:00:00 2001
From: kamel5 <vdr.kamel5 (at) gmx (dot) net>
Date: Sun, 7 Jun 2026 13:07:16 +0200
Subject: [PATCH] Update color for DrawScreenResolution() and DrawTrack()

---
 displaychannel.c | 2 +-
 displayreplay.c  | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/displaychannel.c b/displaychannel.c
index 66dc918..dd85542 100644
--- a/displaychannel.c
+++ b/displaychannel.c
@@ -796,7 +796,7 @@ void cLCARSNGDisplayChannel::Flush(void)
         DrawSeen(Current, Total);
         DrawTrack(osd, xc14 + Margin, yc15 + Margin, xc18 - textBorder - 2 * Margin, yc16 - 2 * Margin,  Theme.Color(clrTrackName), frameColorBg, (zoom) ? smlFont : osdFont, &lastTrackId);
         int x = leftIcons - SymbolSpacing;
-        DrawScreenResolution(osd, xc19 + Margin, yc15 + Margin, x - 2 * Margin, yc16 - 2 * Margin, Theme.Color(clrChannelSymbolOn), frameColorBr, (zoom) ? smlFont : osdFont, &oldResolution);
+        DrawScreenResolution(osd, xc19 + Margin, yc15 + Margin, x - 2 * Margin, yc16 - 2 * Margin, Theme.Color(clrChannelSymbolOn), frameColorBg, (zoom) ? smlFont : osdFont, &oldResolution);
 	DrawEventRec(present, following);
         DrawBlinkingRec();
         }
diff --git a/displayreplay.c b/displayreplay.c
index 728123d..af2ba72 100644
--- a/displayreplay.c
+++ b/displayreplay.c
@@ -512,8 +512,8 @@ void cLCARSNGDisplayReplay::Flush(void)
   if (!modeOnly) {
      DrawBlinkingRec();
      DrawDate(ReplayPixmap, xp14, yp00, xp16, yp01, Theme.Color(clrDateFg), Theme.Color(clrDateBg), osdFont, &lastDate);
-     DrawTrack(ReplayPixmap, xp10 + Margin, yp11 + Margin, xp11 - textBorder - Margin, yp12 - Margin, Theme.Color(clrTrackName), clrTransparent, (zoom) ? smlFont : osdFont, &lastTrackId);
-     DrawScreenResolution(ReplayPixmap, xp12 + Margin, yp11 + Margin, leftIcons - SymbolSpacing - Margin, yp12 - Margin, Theme.Color(clrChannelSymbolOn), frameColorBr, (zoom) ? smlFont : osdFont, resolution, &oldResolution);
+     DrawTrack(ReplayPixmap, xp10 + Margin, yp11 + Margin, xp11 - textBorder - Margin, yp12 - Margin, Theme.Color(clrTrackName), frameColorBg, (zoom) ? smlFont : osdFont, &lastTrackId);
+     DrawScreenResolution(ReplayPixmap, xp12 + Margin, yp11 + Margin, leftIcons - SymbolSpacing - Margin, yp12 - Margin, Theme.Color(clrChannelSymbolOn), frameColorBg, (zoom) ? smlFont : osdFont, resolution, &oldResolution);
      }
   DrawVolume();
 #ifdef DRAWGRID
