diff --git a/thrift-services/remotetranscoder.thrift b/thrift-services/remotetranscoder.thrift
index 2018f3e..2921643 100644
--- a/thrift-services/remotetranscoder.thrift
+++ b/thrift-services/remotetranscoder.thrift
@@ -55,6 +55,32 @@ struct VideoType {
     1: string filename
 }
 
+// Media Source Extensions: the browser appends the segments of the player
+// (fragmented MP4) and the transcoder remuxes them to TS.
+struct MseStartType {
+    1: string responseIp,
+    2: string responsePort,
+    3: string vdrIp,
+    4: string vdrPort,
+    5: string postfix,
+    6: string duration,          // seconds, N/A if unknown (live)
+    7: list<string> tracks       // mime type with codecs of each SourceBuffer
+}
+
+struct MseAppendType {
+    1: string streamId,
+    2: i32 track,                // index in MseStartType.tracks
+    3: binary data
+}
+
+struct MseResetType {
+    1: string streamId           // a seek: drop all data, the next segments start a new stream
+}
+
+struct MseEndOfStreamType {
+    1: string streamId
+}
+
 service RemoteTranscoder extends common.CommonService {
     string Probe(1: ProbeType input) throws (1:common.OperationFailed err),
     bool StreamUrl(1: StreamUrlType input) throws (1:common.OperationFailed err),
@@ -64,4 +90,8 @@ service RemoteTranscoder extends common.CommonService {
     bool Stop(1: StopType input) throws (1:common.OperationFailed err),
     string AudioInfo(1: AudioInfoType input) throws (1:common.OperationFailed err),
     string GetVideo(1: VideoType input) throws (1:common.OperationFailed err),
+    string MseStart(1: MseStartType input) throws (1:common.OperationFailed err),
+    bool MseAppend(1: MseAppendType input) throws (1:common.OperationFailed err),     // false: buffer full
+    bool MseReset(1: MseResetType input) throws (1:common.OperationFailed err),
+    bool MseEndOfStream(1: MseEndOfStreamType input) throws (1:common.OperationFailed err),
 }
diff --git a/thrift-services/src-client/TranscoderClient.cpp b/thrift-services/src-client/TranscoderClient.cpp
index 4fdb2d9..6c55bd3 100644
--- a/thrift-services/src-client/TranscoderClient.cpp
+++ b/thrift-services/src-client/TranscoderClient.cpp
@@ -217,3 +217,56 @@ bool TranscoderClient::GetVideo(std::string &result, const VideoType &input) {
         return true;
     });
 }
+
+bool TranscoderClient::MseStart(std::string &result, const std::string &responseIp, const std::string &responsePort,
+                                const std::string &vdrIp, const std::string &vdrPort, const std::string &postfix,
+                                const std::string &duration, const std::vector<std::string> &tracks) {
+    DEBUGLOG("TranscoderClient::MseStart");
+
+    return processInternal([&]() -> bool {
+        MseStartType input;
+        input.responseIp = responseIp;
+        input.responsePort = responsePort;
+        input.vdrIp = vdrIp;
+        input.vdrPort = vdrPort;
+        input.postfix = postfix;
+        input.duration = duration;
+        input.tracks = tracks;
+
+        client->MseStart(result, input);
+        return true;
+    });
+}
+
+bool TranscoderClient::MseAppend(const std::string &streamId, int track, const std::string &data) {
+    return processInternal([&]() -> bool {
+        MseAppendType input;
+        input.streamId = streamId;
+        input.track = track;
+        input.data = data;
+
+        return client->MseAppend(input);
+    });
+}
+
+bool TranscoderClient::MseReset(const std::string &streamId) {
+    DEBUGLOG("TranscoderClient::MseReset");
+
+    return processInternal([&]() -> bool {
+        MseResetType input;
+        input.streamId = streamId;
+
+        return client->MseReset(input);
+    });
+}
+
+bool TranscoderClient::MseEndOfStream(const std::string &streamId) {
+    DEBUGLOG("TranscoderClient::MseEndOfStream");
+
+    return processInternal([&]() -> bool {
+        MseEndOfStreamType input;
+        input.streamId = streamId;
+
+        return client->MseEndOfStream(input);
+    });
+}
