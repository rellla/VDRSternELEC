From bd55f77864d7d0c907575a348ac8fccbe5fa5a5f Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Sun, 1 Nov 2026 15:35:50 +0100
Subject: [PATCH 38/39] Add an option to install into the standard directories

-Drelease_dir=false installs the binaries into the bindir and the
movies into <datadir>/remotetranscode/movie. The default is still the
subdirectory Release of the build folder.

Co-Authored-By: Claude Opus 5.5
---
 README.md         |  4 ++++
 meson.build       | 20 ++++++++++++++++----
 meson_options.txt |  3 ++-
 3 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/README.md b/README.md
index d639b80..cd3a0f1 100644
--- a/README.md
+++ b/README.md
@@ -10,6 +10,10 @@ meson install
 ```
 The release exists in the subdirectory ```Release``` of the build folder.
 
+With ```meson setup -Drelease_dir=false build``` the binaries are installed into the ```bindir``` of the prefix
+and the movie files into ```<datadir>/remotetranscode/movie```, e.g. ```/usr/local/share/remotetranscode/movie```.
+Then start remotrans with ```-m``` and this directory.
+
 ## Configuration
 A default configuration can be found in folder config: ```sockets.ini```.
 
diff --git a/meson.build b/meson.build
index 3060d79..4142756 100644
--- a/meson.build
+++ b/meson.build
@@ -62,6 +62,18 @@ mini_dep = mini_proj.get_variable('mini_dep')
 dash2ts_proj = subproject('dash2ts')
 dash2ts_dep = dash2ts_proj.get_variable('dash2ts_dep')
 
+#
+# install directories: the subdirectory Release of the build folder (default)
+# or the standard directories of the prefix
+#
+if get_option('release_dir')
+    bin_dir = meson.current_build_dir() + '/Release'
+    movie_dir = bin_dir
+else
+    bin_dir = get_option('bindir')
+    movie_dir = get_option('datadir') / 'remotetranscode'
+endif
+
 incdir = include_directories(['thrift-services/src-gen', 'thrift-services/src-client'])
 trans_compile_args = []
 
@@ -78,22 +90,22 @@ remotrans = executable('remotrans', 'main.cpp', 'logger.cpp', 'streamhandler.cpp
                         include_directories : incdir,
                         cpp_args : trans_compile_args,
                         install : true,
-                        install_dir : meson.current_build_dir() + '/Release',
+                        install_dir : bin_dir,
                         dependencies: [mini_dep, spdlog_dep, tiny_process_library_dep, openssl_dep, thrift_dep])
 
 r_dash2ts = executable('r_dash2ts', 'r_dash2ts.cpp', 'logger.cpp',
                        cpp_args : trans_compile_args,
                        install : true,
-                       install_dir : meson.current_build_dir() + '/Release',
+                       install_dir : bin_dir,
                        dependencies: [spdlog_dep, dash2ts_dep])
 
 r_dash2tsd = executable('r_dash2ts_debug', 'r_dash2ts_debug.cpp', 'logger.cpp',
                        cpp_args : trans_compile_args,
                        install : true,
-                       install_dir : meson.current_build_dir() + '/Release',
+                       install_dir : bin_dir,
                        dependencies: [spdlog_dep, dash2ts_dep])
 
 #
 # install
 #
-install_subdir('static-content/movie', install_dir : meson.current_build_dir() + '/Release')
+install_subdir('static-content/movie', install_dir : movie_dir)
diff --git a/meson_options.txt b/meson_options.txt
index 0b364c6..56974fc 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -1,2 +1,3 @@
 option('debug_thrift', type: 'boolean', value: false, description: 'Enable more debug logging')
-option('vdrsternelec', type: 'boolean', value: false, description: 'Build for VDR*ELEC')
\ No newline at end of file
+option('vdrsternelec', type: 'boolean', value: false, description: 'Build for VDR*ELEC')
+option('release_dir', type: 'boolean', value: true, description: 'Install into the subdirectory Release of the build folder instead of the prefix')
-- 
