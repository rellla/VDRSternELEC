From a47a61f1f75275cfaf159f645cc86f3d17fb5f87 Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Thu, 29 Oct 2026 16:49:35 +0100
Subject: [PATCH 17/39] Keep port and query of the m3u url

The port was appended without ':' and the query string was dropped.
Playlists with tokens in the query returned 403, the probe failed.

Co-Authored-By: Claude Opus 5.5
---
 m3u8handler.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/m3u8handler.cpp b/m3u8handler.cpp
index c2f8a5f..d4380cb 100644
--- a/m3u8handler.cpp
+++ b/m3u8handler.cpp
@@ -25,8 +25,15 @@ m3u_stream M3u8Handler::parseM3u() {
 
     auto uri = uri::parse_uri(webUri);
 
-    httplib::Client cli(uri.scheme + "://" + uri.authority.host + (uri.authority.port > 0 ? std::to_string(uri.authority.port) : ""));
-    auto res = cli.Get(uri.path);
+    httplib::Client cli(uri.scheme + "://" + uri.authority.host + (uri.authority.port > 0 ? ":" + std::to_string(uri.authority.port) : ""));
+
+    // keep the query, playlists are often protected by tokens in the query
+    std::string path = uri.path.empty() ? "/" : uri.path;
+    if (!uri.query_string.empty()) {
+        path += "?" + uri.query_string;
+    }
+
+    auto res = cli.Get(path);
 
     m3u_stream result;
     result.width = result.height = 0;
-- 
