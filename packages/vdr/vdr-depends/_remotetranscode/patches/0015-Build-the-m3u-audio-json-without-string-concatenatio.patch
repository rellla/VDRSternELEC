From d36f7d009735b9110dca87bde6970a71422e0c23 Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Thu, 29 Oct 2026 16:49:09 +0100
Subject: [PATCH 15/39] Build the m3u audio json without string concatenation

A quote in the track name made json::parse() throw.

Co-Authored-By: Claude Opus 5.5
---
 streamhandler.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/streamhandler.cpp b/streamhandler.cpp
index 2ebb9af..9b94414 100644
--- a/streamhandler.cpp
+++ b/streamhandler.cpp
@@ -93,7 +93,10 @@ std::shared_ptr<std::string> StreamHandler::probeVideo(std::string url, std::str
         // the audio infos are filled once per probe, not on every (re)start of the stream
         bstreams = json::array();
         for (const auto& a : m3u.audio) {
-            json st = json::parse("{ \"codec_type\": \"audio\", \"tags\": { \"language\": \"" + a.language + "\", \"comment\": \"" + a.name + "\" }}");
+            json st;
+            st["codec_type"] = "audio";
+            st["tags"]["language"] = a.language;
+            st["tags"]["comment"] = a.name;
             bstreams.push_back(st);
         }
 
