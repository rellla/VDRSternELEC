From f039971af801453120dad58300307f77149d7c5e Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Thu, 29 Oct 2026 16:45:53 +0100
Subject: [PATCH 02/39] Reset the stop flag and terminate ffmpeg on errors

Once the browser or VDR was unreachable, stopRequest stayed set for
the whole handler. Every following stream (seek, resume) was thrown
away while ffmpeg kept running. Reset the flags on a new stream and
terminate ffmpeg if its output can't be delivered.

Co-Authored-By: Claude Opus 5.5
---
 streamhandler.cpp | 26 +++++++++++++++++++++-----
 streamhandler.h   |  8 +++++---
 2 files changed, 26 insertions(+), 8 deletions(-)

diff --git a/streamhandler.cpp b/streamhandler.cpp
index beb4ffd..6123c29 100644
--- a/streamhandler.cpp
+++ b/streamhandler.cpp
@@ -323,6 +323,10 @@ bool StreamHandler::streamVideo(std::string url, std::string position, std::stri
     // never run two ffmpeg processes for the same stream
     stopVideo();
 
+    // a new stream starts without the errors of the previous one
+    stopRequest = false;
+    streamError = false;
+
     // create parameter list
     std::vector<std::string> callStr;
 
@@ -349,8 +353,9 @@ bool StreamHandler::streamVideo(std::string url, std::string position, std::stri
                 if (!browserClient->ping()) {
                     // connection problems? abort transcoding
                     ERROR("Unable to connect to browser. Abort transcoding...");
-                    // stopVideo();
                     stopRequest = true;
+                    terminateStream();
+                    return;
                 }
 
                 std::string packets = std::string(bytes, n);
@@ -359,6 +364,7 @@ bool StreamHandler::streamVideo(std::string url, std::string position, std::stri
                     // This can be happen by intention, e.g. if VDR stops the video player
                     DEBUG("Unable to connect to vdr. Abort transcoding...");
                     stopRequest = true;
+                    terminateStream();
                 }
             }
         },
@@ -398,12 +404,22 @@ bool StreamHandler::resumeVideo(std::string position) {
     return true;
 }
 
+void StreamHandler::terminateStream() {
+    // called from the reader thread: only signal ffmpeg, stopVideo() cleans up
+    TinyProcessLib::Process *p = streamHandler;
+    if (p != nullptr) {
+        p->kill();
+    }
+}
+
 void StreamHandler::stopVideo() {
-    if (streamHandler != nullptr) {
-        streamHandler->kill(true);
-        streamHandler->get_exit_status();
-        delete streamHandler;
+    // the reader thread may still access streamHandler until get_exit_status() returns
+    TinyProcessLib::Process *p = streamHandler.load();
+    if (p != nullptr) {
+        p->kill(true);
+        p->get_exit_status();
         streamHandler = nullptr;
+        delete p;
     }
 }
 
diff --git a/streamhandler.h b/streamhandler.h
index b1687b2..e694077 100644
--- a/streamhandler.h
+++ b/streamhandler.h
@@ -2,6 +2,7 @@
 
 #include <string>
 #include <thread>
+#include <atomic>
 #include "process.hpp"
 #include "BrowserClient.h"
 #include "VdrClient.h"
@@ -17,7 +18,7 @@ class StreamHandler {
 private:
     std::string ffmpeg;
 
-    TinyProcessLib::Process *streamHandler;
+    std::atomic<TinyProcessLib::Process*> streamHandler;
     std::thread *readerThread;
 
     bool enableKodi;
@@ -36,6 +37,7 @@ public:
     bool pauseVideo();
     bool resumeVideo(std::string position);
     void stopVideo();
+    void terminateStream();
     bool seekTo(std::string pos);
 
     bool hasStreamError() { return streamError; };
@@ -49,8 +51,8 @@ private:
     std::string browserIp;
     int browserPort;
 
-    bool streamError;
-    bool stopRequest;
+    std::atomic<bool> streamError;
+    std::atomic<bool> stopRequest;
 
     std::string cookies;
     std::string referer;
