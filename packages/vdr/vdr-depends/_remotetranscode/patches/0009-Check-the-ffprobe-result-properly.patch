From e242f4405d21a488022bcce12b236288b6b4f287 Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Thu, 29 Oct 2026 16:48:09 +0100
Subject: [PATCH 09/39] Check the ffprobe result properly

Only exit code 1 was treated as error. Any other failure ended in
json::parse() of an empty or partial output and threw.

Co-Authored-By: Claude Opus 5.5
---
 streamhandler.cpp | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/streamhandler.cpp b/streamhandler.cpp
index 4004ace..a319b9b 100644
--- a/streamhandler.cpp
+++ b/streamhandler.cpp
@@ -478,8 +478,8 @@ std::shared_ptr<std::string> StreamHandler::probeFfmpeg(const std::string& url)
     int exit = process.get_exit_status();
 
     DEBUG("Probe exit code: {}", exit);
-    if (exit == 1) {
-        ERROR("Probe of '{}' failed.", url);
+    if (exit != 0) {
+        ERROR("Probe of '{}' failed with exit code {}.", url, exit);
         return nullptr;
     }
 
@@ -494,7 +494,18 @@ std::shared_ptr<std::string> StreamHandler::probeFfmpeg(const std::string& url)
 
     *videoResult = "no video";
 
-    json st = json::parse(*output);
+    json st;
+    try {
+        st = json::parse(*output);
+    } catch (json::exception &e) {
+        ERROR("Probe of '{}' returned no usable result: {}", url, e.what());
+        return nullptr;
+    }
+
+    if (!st.is_object() || !st.contains("streams")) {
+        ERROR("Probe of '{}' found no streams.", url);
+        return nullptr;
+    }
 
     ffmpegCopy = false;
     json bestProgram;
