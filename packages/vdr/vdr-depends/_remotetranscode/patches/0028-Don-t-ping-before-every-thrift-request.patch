From 2d7e8c951305079d78fabc346893157b0bb0518c Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Thu, 29 Oct 2026 16:52:45 +0100
Subject: [PATCH 28/39] Don't ping before every thrift request

Every request did an additional ping round trip. Reconnect and repeat
the request once if the connection is broken instead.

Co-Authored-By: Claude Opus 5.5
---
 thrift-services/src-client/BrowserClient.cpp  | 32 +++++++++++++------
 .../src-client/TranscoderClient.cpp           | 32 +++++++++++++------
 thrift-services/src-client/VdrClient.cpp      | 32 +++++++++++++------
 3 files changed, 66 insertions(+), 30 deletions(-)

diff --git a/thrift-services/src-client/BrowserClient.cpp b/thrift-services/src-client/BrowserClient.cpp
index f1e0524..4939028 100644
--- a/thrift-services/src-client/BrowserClient.cpp
+++ b/thrift-services/src-client/BrowserClient.cpp
@@ -97,18 +97,30 @@ bool BrowserClient::ping() {
 template <typename F> bool BrowserClient::processInternal(F&& request) {
     std::lock_guard<std::recursive_mutex> lock(browser_send_mutex);
 
-    if (!ping()) {
-        return false;
-    }
+    // no ping before every request, that doubles the round trips.
+    // If the connection is broken, reconnect once and repeat the request.
+    for (int attempt = 0; attempt < 2; ++attempt) {
+        if (!connect()) {
+            return false;
+        }
 
-    try {
-        return request();
-    } catch (OperationFailed &err) {
-        return false;
-    } catch (TException &err) {
-       transport->close();
-       return false;
+        try {
+            return request();
+        } catch (OperationFailed &err) {
+            return false;
+        } catch (TTransportException &err) {
+            transport->close();
+            if (err.getType() == TTransportException::TIMED_OUT) {
+                // the request may have been processed, don't repeat it
+                return false;
+            }
+        } catch (TException &err) {
+            transport->close();
+            return false;
+        }
     }
+
+    return false;
 }
 
 bool BrowserClient::LoadUrl(const std::string& url) {
