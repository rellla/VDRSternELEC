+bool CefBrowserClient::StopVideo(const StopVideoType& input)
+{
+  send_StopVideo(input);
+  return recv_StopVideo();
+}
+
+void CefBrowserClient::send_StopVideo(const StopVideoType& input)
+{
+  int32_t cseqid = 0;
+  oprot_->writeMessageBegin("StopVideo", ::apache::thrift::protocol::T_CALL, cseqid);
+
+  CefBrowser_StopVideo_pargs args;
+  args.input = &input;
+  args.write(oprot_);
+
+  oprot_->writeMessageEnd();
+  oprot_->getTransport()->writeEnd();
+  oprot_->getTransport()->flush();
+}
+
+bool CefBrowserClient::recv_StopVideo()
+{
+
+  int32_t rseqid = 0;
+  std::string fname;
+  ::apache::thrift::protocol::TMessageType mtype;
+
+  iprot_->readMessageBegin(fname, mtype, rseqid);
+  if (mtype == ::apache::thrift::protocol::T_EXCEPTION) {
+    ::apache::thrift::TApplicationException x;
+    x.read(iprot_);
+    iprot_->readMessageEnd();
+    iprot_->getTransport()->readEnd();
