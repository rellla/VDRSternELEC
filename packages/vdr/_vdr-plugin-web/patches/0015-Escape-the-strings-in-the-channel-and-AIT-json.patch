From 51225ee6736ca1837af238bddd0f6c1927646499 Mon Sep 17 00:00:00 2001
From: Andreas Baierl <ichgeh@imkreisrum.de>
Date: Thu, 29 Oct 2026 17:05:27 +0100
Subject: [PATCH 15/34] Escape the strings in the channel and AIT json

A quote or backslash in a channel or application name produced
invalid json, the browser rejected the channel or the application.

Co-Authored-By: Claude Opus 5.5
---
 ait.cpp      |  4 +++-
 jsonescape.h | 33 +++++++++++++++++++++++++++++++++
 status.cpp   |  4 +++-
 3 files changed, 39 insertions(+), 2 deletions(-)
 create mode 100644 jsonescape.h

diff --git a/ait.cpp b/ait.cpp
index affcb1c..24a06ab 100644
--- a/ait.cpp
+++ b/ait.cpp
@@ -14,6 +14,7 @@
 #include "ait.h"
 #include "status.h"
 #include "web.h"
+#include "jsonescape.h"
 
 #define PMT_SCAN_IDLE     5 // 60 //300    // seconds
 
@@ -40,7 +41,8 @@ const char *hbbtvJson = R"(
 
 inline const char* toHbbtvJson(const char* channelId, const char* channelName, int applicationId, int controlCode, const char* name, const char* urlBase, const char* urlLoc, const char* urlExt) {
     char *buffer;
-    asprintf(&buffer, hbbtvJson, channelId, channelName, applicationId, controlCode, name, urlBase, urlLoc, urlExt);
+    asprintf(&buffer, hbbtvJson, jsonEscape(channelId).c_str(), jsonEscape(channelName).c_str(), applicationId, controlCode,
+             jsonEscape(name).c_str(), jsonEscape(urlBase).c_str(), jsonEscape(urlLoc).c_str(), jsonEscape(urlExt).c_str());
     return buffer;
 }
 
diff --git a/jsonescape.h b/jsonescape.h
new file mode 100644
index 0000000..9c50782
--- /dev/null
+++ b/jsonescape.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <string>
+#include <cstdio>
+
+// escape a string for the use inside a json string literal
+inline std::string jsonEscape(const char *in) {
+    std::string out;
+    if (in == nullptr) {
+        return out;
+    }
+
+    for (const char *p = in; *p; ++p) {
+        unsigned char c = (unsigned char) *p;
+        switch (c) {
+            case '"':  out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\n': out += "\\n"; break;
+            case '\r': out += "\\r"; break;
+            case '\t': out += "\\t"; break;
+            default:
+                if (c < 0x20) {
+                    char buf[8];
+                    snprintf(buf, sizeof(buf), "\\u%04x", c);
+                    out += buf;
+                } else {
+                    out += (char) c;
+                }
+        }
+    }
+
+    return out;
+}
diff --git a/status.cpp b/status.cpp
index 3d3072e..d21d186 100644
--- a/status.cpp
+++ b/status.cpp
@@ -12,6 +12,7 @@
 #include "ait.h"
 #include "BrowserClient.h"
 #include "webosdpage.h"
+#include "jsonescape.h"
 
 const char *channelJson = R"(
     {
@@ -57,7 +58,8 @@ inline const char* toChannelJson(const cChannel* channel) {
     }
 
     char *cmd;
-    asprintf(&cmd, channelJson, *channel->GetChannelID().ToString(), channelType, 1, channel->Nid(), channel->Tid(), channel->Sid(), channel->Name(), channel->Name(), 15);
+    std::string name = jsonEscape(channel->Name());
+    asprintf(&cmd, channelJson, *channel->GetChannelID().ToString(), channelType, 1, channel->Nid(), channel->Tid(), channel->Sid(), name.c_str(), name.c_str(), 15);
     return cmd;
 }
 
