+/**
+ * Forget lost video data (e.g. at a clear or a channel switch)
+ */
+void cOutputDevice::ResetVideoDamage(void)
+{
+	m_videoDamagePending = false;
+	m_dropVideo = false;
+	m_restartVideoDecoder = false;
+}
